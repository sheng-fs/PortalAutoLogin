[Unit]
Description=PortalAutoLogin 门户自动登录
Documentation=https://github.com/sheng-fs/PortalAutoLogin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
ExecStart=__BIN__ daemon
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
