# 统一换行符，避免 Windows 脚本在其它平台被改写
* text=auto

*.cs      text eol=crlf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.md      text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
VERSION   text eol=lf

# 二进制文件
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.exe     binary
*.dll     binary
